# This repository holds the app's code only. Budget data must never be committed.

# budget files, backups and snapshots (all versions)
*.budget
*.budgetsnap
budget-*.json

# seed, rules and bank statements (the app has no .json/.csv/.xlsx files of its own)
*.json
*.csv
*.xlsx
*.xls
*.ofx
*.qfx
*.pdf

# private folder, test output, tooling
private/
out/
node_modules/

# system files
.DS_Store
Thumbs.db

# the sample seed is generic and meant to be shared
!examples/*.example.json
!examples/demo-budget-2026.json

# the tests read your private files from here (or from BUDGET_SEED / BUDGET_RULES); never commit them
rules/
tests/unit/golden.json

# tests and the PDF tools' test generators stay in the private package (they use the owner's own seed and rules): never published
tests/
tools/pdf-layout-dump/dev-tools/
